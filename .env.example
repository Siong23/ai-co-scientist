# Copy to .env (gitignored) and fill in. Keys come ONLY from the environment —
# never write one into code, config.yaml, fixtures, or logs (see AGENTS.md).

# Optional LM Studio overrides. The server is unauthenticated by default.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.6-35b-a3b
LMSTUDIO_API_KEY=

# Optional: only needed when driving the Codex CLI locally.
OPENAI_API_KEY=

# Optional: Semantic Scholar API key for higher search rate limits.
# Without a key: 100 requests / 5 min (public tier — sufficient for normal use).
# With a key:    ~1 request / sec (authenticated tier).
# Apply at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional Elsevier Scopus API key: https://dev.elsevier.com/
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# Optional Tavily web-search key: https://app.tavily.com/
TAVILY_API_KEY=
