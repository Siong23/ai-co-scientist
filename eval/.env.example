# Judge configuration for `--llm-metrics` runs.
#
# Copy this file to `.env` and edit it, then the long command collapses to:
#
#   uv run python scripts/evaluate_run.py ../results/runs/<run-id>.json \
#     --goal-file goals/<goal>.txt --llm-metrics --metric-suite hypothesis
#
# `.env` is git-ignored; this example is not, so never put a real credential
# here. A variable already in the environment always wins over this file, so a
# shell export or a CI variable still overrides whatever is set below, and
# --judge-model / --judge-base-url override both. Everything after the first
# "=" is the value: an inline "#" is part of it, not a comment.

# DeepEval's OpenAI-compatible adapter demands a key even when the LM Studio
# server has authentication turned off, where this is only a placeholder.
LOCAL_MODEL_API_KEY=lm-studio

# The model id exactly as the server reports it at GET /v1/models.
LOCAL_MODEL_NAME=<loaded-model-id>

# The server's OpenAI-compatible base URL.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:1234/v1/

# A reasoning judge spends most of its tokens on hidden reasoning and blows
# through DeepEval's 88.5 s per-attempt and 180 s per-task budgets, failing with
# `RetryError[<Future ... raised TimeoutError>]` instead of a score. Uncomment
# for such a judge; see "Judge timeouts" in README.md.
# DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=2400
# DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=900
